# Copy to .env.local and fill in. NEVER commit real values.

# Local development uses SQLite. Production uses PostgreSQL (see docs/PLAN.md, M9).
DATABASE_URL="file:./dev.db"

# Random string, at least 32 chars. Generate: openssl rand -base64 32
SESSION_SECRET=""

# LINE (M7/M8). Leave empty until then.
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_LIFF_ID=""
LINE_CHANNEL_ACCESS_TOKEN=""

# Chatbot (M5/M6). "mock" needs no key.
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
