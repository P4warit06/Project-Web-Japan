# Copy to .env.local and fill in. NEVER commit real values.
# Production values live in the Vercel dashboard (see docs/DEPLOY.md), not in files.

# ---- Database (PostgreSQL) ----
# Local: start it with `docker compose up -d`, then use this line as is.
DATABASE_URL="postgresql://memorytrip:memorytrip@localhost:5432/memory_trip"
# Production (Neon): DATABASE_URL = the POOLED string (host contains "-pooler"),
# DIRECT_URL = the DIRECT string, used only by `prisma migrate`. Leave DIRECT_URL empty locally.
DIRECT_URL=""
# Tests wipe this database. Its name must contain "test". Default shown here.
# TEST_DATABASE_URL="postgresql://memorytrip:memorytrip@localhost:5432/memory_trip_test"

# ---- Session ----
# Random string, at least 32 chars. Generate: openssl rand -base64 32
SESSION_SECRET=""

# ---- Photo storage ----
# "local" = files in ./storage/uploads (development). "r2" = Cloudflare R2 (production).
STORAGE_PROVIDER="local"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ---- Mock login ----
# Allowed locally. On Vercel it works ONLY for Preview deployments and only with this set to "true".
# It can never be enabled in Production. See features/auth/dev-login.ts.
# ALLOW_DEV_LOGIN="true"

# ---- LINE (M7/M8). Leave empty until then. ----
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_LIFF_ID=""
LINE_CHANNEL_ACCESS_TOKEN=""

# ---- Chatbot (M5/M6). "mock" needs no key. ----
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
